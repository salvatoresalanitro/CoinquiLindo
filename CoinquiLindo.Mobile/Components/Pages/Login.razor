@page "/login"
@layout AuthLayout
@inject AuthClient AuthClient
@inject HttpClient Http
@inject NavigationManager Navigation
@using Microsoft.Extensions.Logging
@inject ILogger<Login> Logger

<div class="login-screen">
    <div class="login-hero">
        <div class="login-logo" aria-hidden="true">ðŸ§¹</div>
        <h1 class="login-title">CoinquiLindo</h1>
        <p class="login-tagline">Patti chiari, casa pulita.</p>
    </div>

    <div class="login-card">
        <h2 class="login-card-title">Bentornato!</h2>
        <p class="login-card-subtitle">Accedi per gestire turni e pulizie con i tuoi coinquilini.</p>

        <ErrorAlert Error="error" OnDismiss="() => error = null" />

        @if (googleUnsupported)
        {
            <div class="alert alert-info small mb-3" role="status">
                L'accesso con Google non Ã¨ disponibile su questa piattaforma. Usa Android o iOS.
            </div>
        }

        <button class="btn-google" @onclick="SignInWithGoogle" disabled="@(isBusy || googleUnsupported)">
            @if (isBusy && activeAction == LoginMethod.Google)
            {
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Accesso in corso...</span>
            }
            else
            {
                <svg class="google-icon" viewBox="0 0 48 48" aria-hidden="true">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                </svg>
                <span>Continua con Google</span>
            }
        </button>

        @* Development-only API endpoint: hidden in Release builds *@
        @if (BuildInfo.IsDebug)
        {
            <div class="dev-login">
                <div class="dev-login-divider"><span>Solo sviluppo</span></div>

                <input type="email" class="form-control mb-2" placeholder="Email" @bind="devEmail" />
                <input type="text" class="form-control mb-2" placeholder="Nome visualizzato" @bind="devDisplayName" />

                <button class="btn btn-outline-secondary w-100" @onclick="DevLogin" disabled="@isBusy">
                    @if (isBusy && activeAction == LoginMethod.Dev)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    }
                    else
                    {
                        <span>Accedi senza Google</span>
                    }
                </button>
            </div>
        }
    </div>
</div>

@code {
    private enum LoginMethod { None, Google, Dev }

    private ApiError? error;
    private bool isBusy;
    // MAUI WebAuthenticator has no Windows implementation: use the dev login there
    private bool googleUnsupported = DeviceInfo.Platform == DevicePlatform.WinUI;
    private LoginMethod activeAction = LoginMethod.None;

    private string devEmail = "salvo@coinquilindo.dev";
    private string devDisplayName = "Salvo";

    protected override async Task OnInitializedAsync()
    {
        if (await AuthClient.IsSignedInAsync())
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private async Task SignInWithGoogle()
    {
        await RunAsync(LoginMethod.Google, async () =>
        {
            WebAuthenticatorResult callback;
            try
            {
                callback = await WebAuthenticator.Default.AuthenticateAsync(new WebAuthenticatorOptions
                {
                    Url = new Uri(Http.BaseAddress!, AuthClient.GoogleSignInPath),
                    CallbackUrl = new Uri(AuthConstants.CallbackUri),
                    // Do not share the Google session with the system browser on shared devices
                    PrefersEphemeralWebBrowserSession = true
                });
            }
            catch (TaskCanceledException)
            {
                // User closed the browser: not an error
                return;
            }
            catch (Exception ex) when (ex is PlatformNotSupportedException or NotImplementedException)
            {
                Logger.LogWarning(ex, "WebAuthenticator not supported on this platform");
                googleUnsupported = true;
                return;
            }

            var result = await AuthClient.CompleteGoogleSignInAsync(callback.Properties);
            HandleResult(result);
        });
    }

    private async Task DevLogin()
    {
        if (string.IsNullOrWhiteSpace(devEmail)) return;

        await RunAsync(LoginMethod.Dev, async () =>
        {
            var result = await AuthClient.DevLoginAsync(devEmail.Trim(), devDisplayName.Trim());
            HandleResult(result);
        });
    }

    private async Task RunAsync(LoginMethod action, Func<Task> work)
    {
        isBusy = true;
        activeAction = action;
        error = null;

        try
        {
            await work();
        }
        finally
        {
            isBusy = false;
            activeAction = LoginMethod.None;
        }
    }

    private void HandleResult(ApiResult result)
    {
        if (result.IsSuccess)
        {
            Navigation.NavigateTo("/", replace: true);
        }
        else
        {
            error = result.Error;
        }
    }
}
