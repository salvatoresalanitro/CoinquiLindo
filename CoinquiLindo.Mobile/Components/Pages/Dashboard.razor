@page "/house/{HouseId:guid}"
@using CoinquiLindo.Shared.Contracts
@inject CoinquiLindoApiClient ApiClient

<div class="container mt-4">
    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p>Caricamento casa...</p>
        </div>
    }
    else if (house == null)
    {
        @* A missing or forbidden house cannot be fixed by retrying; network/server errors can *@
        <ErrorAlert Error="loadError" OnRetry="@(loadError?.Status is 403 or 404 ? default : EventCallback.Factory.Create(this, LoadHouseData))" />
    }
    else
    {
        <ErrorAlert Error="refreshError" OnRetry="RefreshHouseData" OnDismiss="() => refreshError = null" />

        <h2 class="mb-4">@house.Name</h2>

        <!-- Flatmate section -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h4 class="mb-0">Coinquilini</h4>
            </div>
            <div class="card-body">
                @if (house.Tenants.Any())
                {
                    <ul class="list-group mb-3">
                        @foreach (var tenant in house.Tenants)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @tenant.Name
                                <span class="badge bg-secondary rounded-pill">👤</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Nessun coinquilino registrato.</p>
                }

                <!-- Invite flatmates -->
                <div class="invite-box mt-3 p-3 rounded-3 bg-light border">
                    <div class="small text-muted mb-1">Invita i coinquilini con questo codice</div>
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <span class="invite-code fw-bold font-monospace fs-4">@InviteCodes.Format(house.InviteCode)</span>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CopyInviteCode">
                                @(isCopied ? "Copiato ✓" : "Copia")
                            </button>
                            <button class="btn btn-primary btn-sm" type="button" @onclick="ShareInviteCode">Condividi</button>
                        </div>
                    </div>

                    @if (isConfirmingRegenerate)
                    {
                        <div class="mt-3 small">
                            <p class="mb-2">Il codice attuale smetterà di funzionare. Continuare?</p>
                            <div class="d-flex gap-2">
                                <button class="btn btn-danger btn-sm" type="button" @onclick="RegenerateInviteCode" disabled="@isRegenerating">
                                    @if (isRegenerating)
                                    {
                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                    }
                                    else
                                    {
                                        <span>Rigenera</span>
                                    }
                                </button>
                                <button class="btn btn-link btn-sm" type="button" @onclick="() => isConfirmingRegenerate = false" disabled="@isRegenerating">Annulla</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-link btn-sm px-0 mt-2" type="button" @onclick="() => isConfirmingRegenerate = true">Genera un nuovo codice</button>
                    }

                    <div class="mt-2">
                        <ErrorAlert Error="inviteError" OnDismiss="() => inviteError = null" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Rooms section -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h4 class="mb-0">Stanze</h4>
            </div>
            <div class="card-body">
                @if (house.Rooms.Any())
                {
                    <ul class="list-group mb-3">
                        @foreach (var room in house.Rooms)
                        {
                            <li class="list-group-item">
                                <div class="fw-semibold">@room.Name</div>
                                @if (room.CleaningTasks.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1 mt-2">
                                        @foreach (var task in room.CleaningTasks)
                                        {
                                            <span class="badge rounded-pill text-bg-light border">@task.Description</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <small class="text-muted">Nessuna attività di pulizia</small>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Nessuna stanza registrata. Aggiungi la prima!</p>
                }

                <!-- Add room -->
                <div class="mt-3">
                    <input type="text" class="form-control mb-2" placeholder="Nome stanza (es. Cucina)..." @bind="newRoomName" @bind:event="oninput" />

                    <div class="input-group mb-2">
                        <input type="text" class="form-control" placeholder="Attività di pulizia + Invio" @bind="newTaskDescription" @bind:event="oninput" @onkeydown="HandleTaskKeyDown" />
                        <button class="btn btn-outline-secondary" type="button" @onclick="AddPendingTask">+</button>
                    </div>

                    @if (pendingTasks.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var task in pendingTasks)
                            {
                                <span class="badge rounded-pill text-bg-primary d-flex align-items-center gap-1">
                                    @task
                                    <button type="button" class="btn-close btn-close-white" style="font-size: .5rem" aria-label="Rimuovi" @onclick="() => pendingTasks.Remove(task)"></button>
                                </span>
                            }
                        </div>
                    }

                    <ErrorAlert Error="roomError" OnDismiss="() => roomError = null" />

                    <button class="btn btn-primary w-100" type="button" @onclick="HandleAddRoom" disabled="@(isAddingRoom || string.IsNullOrWhiteSpace(newRoomName))">
                        @if (isAddingRoom)
                        {
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        }
                        else
                        {
                            <span>Aggiungi stanza</span>
                        }
                    </button>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h4 class="mb-0">Turni</h4>
            </div>
            <div class="card-body">
                <ErrorAlert Error="shiftError" OnRetry="LoadShiftData" OnDismiss="() => shiftError = null" />

                <div class="border rounded-3 bg-light p-3 mb-4">
                    <h5 class="mb-3">Assegna un turno</h5>
                    @if (house.Tenants.Count == 0 || house.Rooms.Count == 0)
                    {
                        <p class="text-muted mb-0">Aggiungi almeno un coinquilino e una stanza per creare un turno.</p>
                    }
                    else
                    {
                        <div class="mb-2">
                            <label class="form-label" for="shift-tenant">Coinquilino</label>
                            <select id="shift-tenant" class="form-select" @bind="selectedTenantId">
                                @foreach (var tenant in house.Tenants)
                                {
                                    <option value="@tenant.Id">@tenant.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="shift-room">Stanza</label>
                            <select id="shift-room" class="form-select" @bind="selectedRoomId">
                                @foreach (var room in house.Rooms)
                                {
                                    <option value="@room.Id">@room.Name</option>
                                }
                            </select>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col">
                                <label class="form-label" for="shift-start">Dal</label>
                                <input id="shift-start" type="date" class="form-control" @bind="newShiftStartDate" />
                            </div>
                            <div class="col">
                                <label class="form-label" for="shift-end">Al</label>
                                <input id="shift-end" type="date" class="form-control" @bind="newShiftEndDate" />
                            </div>
                        </div>
                        <button class="btn btn-primary w-100" type="button" @onclick="HandleAssignShift" disabled="@(!CanAssignShift || isAssigningShift)">
                            @if (isAssigningShift)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            }
                            else
                            {
                                <span>Crea turno</span>
                            }
                        </button>
                    }
                </div>

                @if (isLoadingShifts)
                {
                    <div class="text-center py-3">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <span class="ms-2">Caricamento turni...</span>
                    </div>
                }
                else if (shifts.Count == 0)
                {
                    <p class="text-muted mb-0">Nessun turno assegnato.</p>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var shift in shifts)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="fw-semibold">@shift.AssignedRoomName · @shift.AssignedTenantName</div>
                                        <small class="text-muted">
                                            @shift.StartDate.ToString("dd/MM/yyyy") – @shift.EndDate.ToString("dd/MM/yyyy")
                                        </small>
                                    </div>
                                    @if (IsPastShift(shift))
                                    {
                                        <span class="badge text-bg-secondary">Storico</span>
                                    }
                                    else if (shift.Checklist.Count == 0)
                                    {
                                        <span class="badge text-bg-secondary">Nessuna attività</span>
                                    }
                                    else if (shift.IsShiftFullyCompleted)
                                    {
                                        <span class="badge text-bg-success">Completato</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-primary">Da fare</span>
                                    }
                                </div>

                                @if (shift.Checklist.Count > 0)
                                {
                                    <ul class="list-group list-group-flush mt-2">
                                        @foreach (var item in shift.Checklist)
                                        {
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 gap-2">
                                                <span class="@(item.IsCompleted ? "text-decoration-line-through text-muted" : string.Empty)">
                                                    @item.Description
                                                </span>
                                                @if (item.IsCompleted)
                                                {
                                                    <span class="small text-success">Fatto</span>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-success btn-sm flex-shrink-0"
                                                            type="button"
                                                            @onclick="() => CompleteChecklistItem(shift.Id, item.Id)"
                                                            disabled="@completingChecklistItemId.HasValue">
                                                        Completa
                                                    </button>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <small class="text-muted d-block mt-2">Nessuna attività prevista.</small>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid HouseId { get; set; }

    private HouseResponse? house;
    private bool isLoading = true;
    private ApiError? loadError;
    private ApiError? refreshError;

    private bool isCopied;
    private bool isConfirmingRegenerate;
    private bool isRegenerating;
    private ApiError? inviteError;

    private string newRoomName = "";
    private string newTaskDescription = "";
    private readonly List<string> pendingTasks = new();
    private bool isAddingRoom = false;
    private ApiError? roomError;

    private List<ShiftResponse> shifts = [];
    private bool isLoadingShifts;
    private bool isAssigningShift;
    private Guid? completingChecklistItemId;
    private ApiError? shiftError;
    private string selectedTenantId = string.Empty;
    private string selectedRoomId = string.Empty;
    private DateTime newShiftStartDate = DateTime.UtcNow.Date;
    private DateTime newShiftEndDate = DateTime.UtcNow.Date.AddDays(7);

    private bool CanAssignShift =>
        house is not null &&
        house.Tenants.Count > 0 &&
        house.Rooms.Count > 0 &&
        Guid.TryParse(selectedTenantId, out _) &&
        Guid.TryParse(selectedRoomId, out _) &&
        newShiftEndDate.Date > newShiftStartDate.Date;

    protected override async Task OnInitializedAsync()
    {
        await LoadHouseData();
    }

    private async Task LoadHouseData()
    {
        isLoading = true;
        loadError = null;

        var result = await ApiClient.GetHouseAsync(HouseId);
        house = result.Value;
        loadError = result.Error;

        if (house is not null)
        {
            SetShiftSelectionDefaults();
            await LoadShiftData();
        }

        isLoading = false;
    }

    // Refresh after a mutation keeps the current data on screen if the reload fails
    private async Task RefreshHouseData()
    {
        refreshError = null;

        var result = await ApiClient.GetHouseAsync(HouseId);

        if (result.IsSuccess)
        {
            house = result.Value;
            SetShiftSelectionDefaults();
            await LoadShiftData();
        }
        else
        {
            refreshError = result.Error;
        }
    }

    private async Task LoadShiftData()
    {
        isLoadingShifts = true;
        shiftError = null;

        var result = await ApiClient.GetHouseShiftsAsync(HouseId);
        if (result.IsSuccess)
        {
            shifts = result.Value!;
        }
        else
        {
            shiftError = result.Error;
        }

        isLoadingShifts = false;
    }

    private void SetShiftSelectionDefaults()
    {
        if (house is null)
        {
            return;
        }

        if (string.IsNullOrEmpty(selectedTenantId) && house.Tenants.Count > 0)
        {
            selectedTenantId = house.Tenants[0].Id.ToString();
        }

        if (string.IsNullOrEmpty(selectedRoomId) && house.Rooms.Count > 0)
        {
            selectedRoomId = house.Rooms[0].Id.ToString();
        }
    }

    private async Task HandleAssignShift()
    {
        if (!CanAssignShift ||
            !Guid.TryParse(selectedTenantId, out var tenantId) ||
            !Guid.TryParse(selectedRoomId, out var roomId))
        {
            return;
        }

        isAssigningShift = true;
        shiftError = null;

        var request = new AssignShiftRequest(
            tenantId,
            roomId,
            DateTime.SpecifyKind(newShiftStartDate.Date, DateTimeKind.Utc),
            DateTime.SpecifyKind(newShiftEndDate.Date, DateTimeKind.Utc));
        var result = await ApiClient.AssignShiftAsync(HouseId, request);

        if (result.IsSuccess)
        {
            await LoadShiftData();
        }
        else
        {
            shiftError = result.Error;
        }

        isAssigningShift = false;
    }

    private async Task CompleteChecklistItem(Guid shiftId, Guid itemId)
    {
        if (completingChecklistItemId.HasValue)
        {
            return;
        }

        completingChecklistItemId = itemId;
        shiftError = null;

        try
        {
            var result = await ApiClient.CompleteShiftChecklistItemAsync(HouseId, shiftId, itemId);
            if (result.IsSuccess)
            {
                await LoadShiftData();
            }
            else
            {
                shiftError = result.Error;
            }
        }
        finally
        {
            completingChecklistItemId = null;
        }
    }

    private static bool IsPastShift(ShiftResponse shift) => shift.EndDate.Date < DateTime.UtcNow.Date;

    private async Task CopyInviteCode()
    {
        if (house is null) return;

        await Clipboard.Default.SetTextAsync(InviteCodes.Format(house.InviteCode));
        isCopied = true;
        StateHasChanged();

        await Task.Delay(TimeSpan.FromSeconds(2));
        isCopied = false;
    }

    private async Task ShareInviteCode()
    {
        if (house is null) return;

        await Share.Default.RequestAsync(new ShareTextRequest
        {
            Title = "Invita un coinquilino",
            Text = $"Unisciti a \"{house.Name}\" su CoinquiLindo! Apri l'app e inserisci il codice: {InviteCodes.Format(house.InviteCode)}"
        });
    }

    private async Task RegenerateInviteCode()
    {
        if (house is null) return;

        isRegenerating = true;
        inviteError = null;

        var result = await ApiClient.RegenerateInviteCodeAsync(HouseId);

        if (result.IsSuccess)
        {
            house = house with { InviteCode = result.Value!.InviteCode };
            isConfirmingRegenerate = false;
        }
        else
        {
            inviteError = result.Error;
        }

        isRegenerating = false;
    }

    private void HandleTaskKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddPendingTask();
    }

    private void AddPendingTask()
    {
        var description = newTaskDescription.Trim();
        if (description.Length > 0 && !pendingTasks.Contains(description, StringComparer.OrdinalIgnoreCase))
        {
            pendingTasks.Add(description);
        }

        newTaskDescription = string.Empty;
    }

    private async Task HandleAddRoom()
    {
        if (string.IsNullOrWhiteSpace(newRoomName)) return;

        isAddingRoom = true;
        roomError = null;

        var result = await ApiClient.AddRoomAsync(HouseId, newRoomName.Trim(), pendingTasks.ToList());

        if (result.IsSuccess)
        {
            newRoomName = string.Empty;
            pendingTasks.Clear();
            await RefreshHouseData();
        }
        else
        {
            roomError = result.Error;
        }

        isAddingRoom = false;
    }
}