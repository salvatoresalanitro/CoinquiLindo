@inherits LayoutComponentBase
@implements IDisposable
@inject AuthClient AuthClient
@inject SecureTokenStore TokenStore
@inject NavigationManager Navigation
@inject PushRegistrationService PushRegistration

@if (isCheckingSession)
{
    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="spinner-border text-primary" role="status" aria-label="Caricamento"></div>
    </div>
}
else
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4">
                <div class="ms-auto"><NotificationBell /></div>
            </div>

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
}

@code {
    private bool isCheckingSession = true;

    protected override async Task OnInitializedAsync()
    {
        TokenStore.SessionEnded += OnSessionEnded;

        if (!await AuthClient.IsSignedInAsync())
        {
            GoToLogin();
            return;
        }

        isCheckingSession = false;

        // A push tapped while the app was closed: open the inbox once the session is confirmed
        PushBridge.PendingRouteChanged += OnPendingRouteChanged;
        OnPendingRouteChanged();
        _ = PushRegistration.StartAsync();
    }

    private void OnPendingRouteChanged() => _ = InvokeAsync(() =>
    {
        if (PushBridge.ConsumePendingRoute() is { } route)
        {
            Navigation.NavigateTo(route);
        }
    });

    // Raised from the HTTP pipeline (refresh rejected) or by logout: may not run on the renderer thread
    private void OnSessionEnded() => _ = InvokeAsync(GoToLogin);

    private void GoToLogin() => Navigation.NavigateTo("/login", replace: true);

    public void Dispose()
    {
        TokenStore.SessionEnded -= OnSessionEnded;
        PushBridge.PendingRouteChanged -= OnPendingRouteChanged;
    }
}
