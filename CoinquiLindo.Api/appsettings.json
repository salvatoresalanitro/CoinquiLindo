{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReportPhotos": {
    "RootPath": "App_Data/report-photos"
  },
  "RateLimiting": {
    "Invites": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Auth": {
    "MobileCallbackUri": "coinquilindo://auth",
    "Jwt": {
      "Issuer": "coinquilindo-api",
      "Audience": "coinquilindo-mobile",
      "AccessTokenLifetime": "00:15:00",
      "RefreshTokenLifetime": "30.00:00:00"
    }
  }
}
